  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "Wake word and speaker verification gate the microphone before any transcription happens.",
        "ASR and TTS run as separate local services in their own venvs because of cuDNN conflicts.",
        "The main loop streams the LLM reply sentence by sentence into TTS."
      ]
    },
    {
      "dot": "amber",
      "title": "Tools",
      "items": [
        "Six local tools live in one registry; the LLM must pick from it or say it cannot.",
        "News flashes are broadcast on a schedule, not only on request."
      ]
    },
    {
      "dot": "violet",
      "title": "Not shown",
      "items": [
        "scripts/ probes and audits, tests/, the archived UI, and the character assets under avatar/yeli."
      ]
    }
